# Copy to .env.local for local work; set the same names in the hosting provider for production.
# NEXT_PUBLIC_* values are inlined at build time: change one, then redeploy (not just restart).

# --- Meta (Facebook / Instagram) ---------------------------------------------------------------
# Pixel id (Events Manager > Data sources). Public. Leave empty to turn Meta tracking off.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API token (Events Manager > Settings > Conversions API > Generate access token).
# Secret, server only. Without it only the browser Pixel's Lead is sent.
META_CAPI_ACCESS_TOKEN=
# Optional. Events Manager > Test events shows a code like TEST12345. While set, server events go
# to the Test events tab instead of production data: remove it after testing.
META_CAPI_TEST_EVENT_CODE=

# --- Google --------------------------------------------------------------------------------------
# GA4 measurement id (G-XXXXXXXXXX). Public. Leave empty to turn Google Analytics off.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Ads tag id (AW-XXXXXXXXXX). Public. Optional: leave empty and only GA4 runs.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# --- Waitlist destinations (set at least one) ---------------------------------------------------
# Loops API key (Settings > API). Secret, server only. Signups become Loops contacts.
LOOPS_API_KEY=
# Slack incoming webhook URL for the signup notification. Secret, server only.
SLACK_WEBHOOK_URL=

# --- Privacy policy (required: a production build fails without them) ---------------------------
# The person in charge of personal information (Québec Law 25), shown on the privacy pages. Public.
NEXT_PUBLIC_PRIVACY_OFFICER_NAME=
NEXT_PUBLIC_PRIVACY_OFFICER_EMAIL=

# --- Demo ---------------------------------------------------------------------------------------
# Number visitors text to reach Dora, in E.164 format. Public. Defaults to the number below.
NEXT_PUBLIC_DEMO_SMS_NUMBER=+14385333509
